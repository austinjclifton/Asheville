---
config:
  layout: elk
---
erDiagram
    direction TB

    BEEKEEPER {
        id bigint PK
        username string
        password_hash string
        email string
        phone string
        created_at timestamp
        updated_at timestamp
    }

    HIVE {
        id bigint PK
        beekeeper_id bigint FK
        name string
        notes string
        created_at timestamp
        updated_at timestamp
    }

    SESSION {
        id bigint PK
        beekeeper_id bigint FK
        session_token string
        active bool
        created_at timestamp
        expires_at timestamp
        last_activity_at timestamp
    }

    DEVICE {
        id bigint PK
        hive_id bigint FK
        installed_at timestamp
        last_seen_at timestamp
        active bool
    }

    READING {
        id bigint PK
        device_id bigint FK
        recorded_at timestamp
        temperature_c float
        battery_voltage float
        signal_strength float
        created_at timestamp
    }

    BEEKEEPER ||--o{ HIVE : owns
    BEEKEEPER ||--o{ SESSION : has
    HIVE ||--o{ DEVICE : has
    DEVICE ||--o{ READING : reports
